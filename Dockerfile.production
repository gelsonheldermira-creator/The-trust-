FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY the_trust_backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY the_trust_backend/ ./
COPY the_trust_site/ /usr/share/nginx/html/
COPY deploy/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN mkdir -p /data && chown -R www-data:www-data /var/lib/nginx /var/log/nginx
EXPOSE 10000
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
